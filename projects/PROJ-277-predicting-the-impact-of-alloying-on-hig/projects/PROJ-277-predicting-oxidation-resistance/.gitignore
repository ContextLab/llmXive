# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
sdist/
wheels/

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
.hypothesis/

# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter Notebook / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Data science artifacts (large/raw data files)
data/raw/*
!data/raw/.gitkeep
*.parquet
*.hdf5
*.h5
*.feather

# Model artifacts
*.pkl
*.pickle
*.joblib
models/
checkpoints/

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Cache directories
.cache/
.mypy_cache/
.ruff_cache/
.flake8

# SHAP / plotting outputs (regenerable)
figures/
*.png
!docs/**/*.png