# Makefile for PROJ-008-psychology-research
#
# The ``setup`` target creates the required directory layout and records
# the pinned Python dependencies.  It is used by the Quickstart guide
# and by CI pipelines.
#
# Usage:
#   make setup
#
# The command is intentionally simple – it just invokes the Python
# helper script which performs all checks and will abort with a non‑zero
# status on failure.

.PHONY: setup

setup:
\tpython code/setup_project.py