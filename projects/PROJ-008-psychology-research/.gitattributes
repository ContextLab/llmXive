# Ensure consistent line endings for Python files
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
# Binary files should not have line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.csv binary # CSVs often have platform-specific line endings, keep as is or handle explicitly
