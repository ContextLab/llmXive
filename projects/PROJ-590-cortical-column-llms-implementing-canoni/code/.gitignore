# Data directory exclusions (keep specific subdirs)
data/
!data/configs/
!data/results/
!data/logs/

# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Logs and temporary files
*.log
*.tmp
*.temp
.coverage
htmlcov/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# State files are tracked (per Constitution Principle V)
# state/*.yaml is explicitly tracked

# OS specific
.DS_Store
Thumbs.db