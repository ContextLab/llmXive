# Data directory - exclude from version control (large files)
data/

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs (handled by data/logs exclusion)
*.log

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# State directory MUST be tracked (Constitution Principle V)
# Explicitly ensuring state/*.yaml is NOT excluded
# The line below is a comment for clarity; the pattern 'data/' above handles the rest.
# We do NOT list state/ here to ensure it is tracked.

# Temporary files
*.tmp
.tmp/

# OS specific
Thumbs.db
.DS_Store
