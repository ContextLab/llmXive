# Data directories (raw and processed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*$py.class
.python-version

# Model caches (Hugging Face and others)
.cache/
data/models/*
!data/models/.gitkeep

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
