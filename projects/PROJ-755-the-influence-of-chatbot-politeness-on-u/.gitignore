# Data directories (raw and processed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Model caches and large files
.cache/
models/
*.pth
*.bin
*.safetensors

# Environment files (secrets)
.env
.env.local
.env.production

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/