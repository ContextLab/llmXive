[flake8]
# Flake8 Configuration
# Fallback configuration for CI environments that prefer flake8
max-line-length = 100
extend-ignore = E203, W503, D100, D104, D203, D213
exclude =
    .git,
    __pycache__,
    data,
    .venv,
    build,
    dist
count = True
show-source = True
statistics = True
max-complexity = 10
