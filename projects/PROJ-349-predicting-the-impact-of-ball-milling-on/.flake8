[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    .eggs,
    *.egg-info,
    data,
    results,
    tests,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    coverage,
    .coverage
per-file-ignores =
    # Allow long lines in docstrings and comments
    */__init__.py: F401
    tests/*: S101, E501
    data/*: E501
    results/*: E501
inline-quotes = double
multiline-quotes = double
doctests = True
show-source = True
statistics = True
count = True
max-complexity = 10