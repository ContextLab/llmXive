# R Styler configuration – ensures consistent R code formatting across the project
# The Styler package reads options from the R session; we set a sensible default.
if (requireNamespace("styler", quietly = TRUE)) {
  options(
    styler.indent_by = 2,
    styler.blank_lines = list(
      before_function = TRUE,
      after_function = TRUE,
      before_if = TRUE,
      after_if = TRUE
    )
  )
}