# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Environment and virtual environments
env/
.env
.venv/
venv/

# Data artifacts (raw and processed)
data/raw/*.nii*
data/raw/*.gz
data/processed/*.csv
data/processed/*.tsv
data/processed/*.log
data/processed/*.json
data/processed/*.parquet

# State and logs
state/*.log
logs/

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Figures and plots (optional, often large)
figures/*.png
figures/*.pdf

# Testing and coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Temporary files
*.tmp
.tmp/