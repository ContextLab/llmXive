[flake8]
# Linting configuration for PROJ-799
# Scopes checks to the code/ directory
max-line-length = 88
extend-ignore = E203, E266, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    data,
    tests
per-file-ignores =
    # Allow longer lines in docstrings if needed
    code/utils/prime_sieve.py: E501
    code/generate_partitions.py: E501
