[flake8]
# Linting configuration for PROJ-799
# Scoped to code/ directory via tox/CI, but these are the default rules
max-line-length = 100
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    data,
    state
per-file-ignores =
    # Allow unused imports in __init__.py if present
    */__init__.py: F401
    # Allow assert in tests
    tests/*: S101
