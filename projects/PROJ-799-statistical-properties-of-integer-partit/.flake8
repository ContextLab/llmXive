[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    env,
    build,
    dist
per-file-ignores =
    # Allow longer lines in test files for readability of expected values
    tests/*: E501
    # Allow specific style in setup scripts if needed
    code/setup_structure.py: E402
