[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .venv,
    venv,
    env
per-file-ignores =
    # Allow unused imports in __init__.py for public API exposure
    */__init__.py: F401
    # Allow unused arguments in test functions (pytest fixtures)
    tests/*.py: F841
inline-quotes = single
multiline-quotes = double
show-source = true
count = true
statistics = true
max-complexity = 15