[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    .hg,
    .mypy_cache,
    .tox,
    .venv,
    venv,
    _build,
    buck-out,
    build,
    dist,
    .eggs,
    *.pyc,
    __pycache__
per-file-ignores =
    # Allow longer lines in config files or generated data
    */config.py: E501
    */data_model.py: E501
# Ensure compatibility with black formatting
ignore = E122, E123, E124, E126, E127, E128, E129, E203, E265, E501, W503
