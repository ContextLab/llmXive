[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    data,
    artifacts,
    .venv,
    venv
per-file-ignores =
    # Allow unused imports in __init__.py for API exposure
    */__init__.py: F401
    # Allow docstrings to be missing in test files
    tests/*: D100,D101,D102,D103
