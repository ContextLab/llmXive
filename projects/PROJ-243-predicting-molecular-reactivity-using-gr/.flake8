[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    data,
    artifacts,
    .mypy_cache
# Enable flake8 plugins if any are installed
select = C,E,F,W,B,B950
# Compatibility with black formatting
ignore = E501,F401
# Enable per-file-ignores if needed
per-file-ignores =
    __init__.py:F401
# Show source code in warnings
show-source = True
# Enable statistics output
statistics = True
# Enable color output (if supported)
color = True
# Enable inline comments for noqa
inline-quotes = double
# Ensure consistent import ordering
import-order-style = google
application-import-names = config, utils, code, data, specs, contracts, tests
# Enable built-in docstring checks
docstring-convention = google
# Set max complexity
max-complexity = 10
# Enable line break before binary operator (PEP8)
hang-closing = True
# Ensure trailing newline
require-blank-line-before-nested-class-or-def = True
# Enforce newline at end of file
eof-newline = True
# Ensure no multiple statements per line
max-statements-per-line = 1
# Additional settings can be added as needed.