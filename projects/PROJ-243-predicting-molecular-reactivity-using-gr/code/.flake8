[flake8]
max-line-length = 100
ignore = E203, W503, E731, E741
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    data,
    artifacts,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py if we add them later
    */__init__.py: F401
    # Allow print statements in scripts for debugging/logging during dev
    code/*.py: T201
