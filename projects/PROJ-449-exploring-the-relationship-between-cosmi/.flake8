[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    data/
per-file-ignores =
    # Allow unused imports in __init__.py
    code/*/__init__.py: F401, F403
    # Allow imports in main entry points
    code/main.py: F401
    code/setup_data_dirs.py: F401
# Specific rules for this project
ignore = E203, E501, W503
