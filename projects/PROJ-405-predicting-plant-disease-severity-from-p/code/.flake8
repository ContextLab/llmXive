# Flake8 configuration for PROJ-405
# Complementary to Ruff, used for specific CI checks if needed

[flake8]
# Maximum line length (Black handles formatting, but flake8 checks)
max-line-length = 88

# Ignore specific error codes
ignore = 
    E501,  # Line too long (handled by Black)
    W503,  # Line break before binary operator (Black style)
    E203,  # Whitespace before ':' (Black style)
    F401,  # Imported but unused (Ruff handles this better in dev)
    B008,  # Function calls in defaults
    ARG001 # Unused arguments

# Exclude directories
exclude =
    .git,
    __pycache__,
    .eggs,
    build,
    dist,
    venv,
    data,
    .pytest_cache

# Maximum complexity for McCabe complexity check
max-complexity = 15
