{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Eigenstate Schema",
  "description": "Schema for individual eigenstate data including probability density",
  "type": "object",
  "required": [
    "L",
    "W",
    "eigenvalue",
    "eigenvector",
    "probability_density"
  ],
  "properties": {
    "L": {
      "type": "integer",
      "description": "System size (number of sites)"
    },
    "W": {
      "type": "number",
      "description": "Disorder strength"
    },
    "eigenvalue": {
      "type": "number",
      "description": "Energy eigenvalue E"
    },
    "eigenvector": {
      "type": "array",
      "description": "Complex or real eigenvector components",
      "items": {
        "type": "number"
      }
    },
    "probability_density": {
      "type": "array",
      "description": "Squared modulus of eigenvector components |ψ_i|^2",
      "items": {
        "type": "number"
      }
    },
    "realization_index": {
      "type": "integer",
      "description": "Index of the disorder realization"
    },
    "index_in_spectrum": {
      "type": "integer",
      "description": "Position of this eigenstate in the sorted spectrum"
    }
  }
}
