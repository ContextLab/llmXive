{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hamiltonian Schema",
  "description": "Schema for 1D tight-binding Hamiltonian matrix and metadata",
  "type": "object",
  "required": [
    "L",
    "W",
    "eigenvalues",
    "eigenvectors"
  ],
  "properties": {
    "L": {
      "type": "integer",
      "description": "System size (number of sites in the chain)"
    },
    "W": {
      "type": "number",
      "description": "Disorder strength (uniform distribution width)"
    },
    "eigenvalues": {
      "type": "array",
      "description": "Sorted eigenvalues of the Hamiltonian",
      "items": {
        "type": "number"
      }
    },
    "eigenvectors": {
      "type": "array",
      "description": "Eigenvectors of the Hamiltonian as column vectors",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "realization_index": {
      "type": "integer",
      "description": "Unique identifier for this disorder realization"
    },
    "seed": {
      "type": "integer",
      "description": "Random seed used for reproducibility"
    },
    "hopping": {
      "type": "number",
      "description": "Hopping parameter t (default 1.0)",
      "default": 1.0
    }
  }
}
