{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Localization Length Schema",
  "description": "Schema for localization length results derived from finite-size scaling",
  "type": "object",
  "required": [
    "L",
    "W",
    "participation_ratio",
    "localization_length"
  ],
  "properties": {
    "L": {
      "type": "integer",
      "description": "System size used for calculation"
    },
    "W": {
      "type": "number",
      "description": "Disorder strength"
    },
    "participation_ratio": {
      "type": "number",
      "description": "Participation Ratio PR = (Σ|ψ_i|²)² / Σ|ψ_i|⁴"
    },
    "localization_length": {
      "type": "number",
      "description": "Extracted localization length ξ from finite-size scaling fit"
    },
    "energy_window": {
      "type": "object",
      "description": "Energy range used for averaging (|E| < cutoff)",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "cutoff": { "type": "number" }
      }
    },
    "fit_quality": {
      "type": "object",
      "description": "Metrics describing the quality of the scaling fit",
      "properties": {
        "r_squared": { "type": "number" },
        "residual_norm": { "type": "number" },
        "converged": { "type": "boolean" }
      }
    },
    "realization_index": {
      "type": "integer",
      "description": "Index of the disorder realization"
    },
    "seed": {
      "type": "integer",
      "description": "Random seed used"
    }
  }
}