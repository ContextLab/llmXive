[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    data,
    docs,
    specs
per-file-ignores =
    # Allow imports in __init__.py
    __init__.py:F401
    # Allow unused imports in test files for setup
    tests/*:F401
max-complexity = 15
ignore = E203, W503, E731
