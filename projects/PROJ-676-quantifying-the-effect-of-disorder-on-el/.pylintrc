[MAIN]
ignore=tests,data,docs,specs,.git,__pycache__,build,dist,.eggs,*.egg-info
persistent=yes
load-plugins=

[MESSAGES CONTROL]
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    R0903,  # too-few-public-methods
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    R0915,  # too-many-statements
    W0511,  # fixme
    W1203,  # logging-f-string
    R0801,  # duplicate-code
    E1101,  # no-member (dynamic attributes in some cases)
    R0401,  # cyclic-import

[DESIGN]
max-args=10
max-locals=25
max-returns=6
max-branches=20
max-statements=60
max-attributes=15
max-public-methods=25

[FORMAT]
max-line-length=88
indent-string='    '

[BASIC]
good-names=i,j,k,ex,_,f,t,x,y,z,df,fs,rs,ax,fig,wr,pr,xi,pr_val,tm_val

[TYPECHECK]
ignored-classes=ndarray

[SIMILARITIES]
min-similarity-lines=6
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=no