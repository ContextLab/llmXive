[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    .eggs,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py for exposing public API
    */__init__.py: F401
    # Allow unused arguments in test functions (pytest pattern)
    tests/*.py: ARG001, ARG002
# Ensure consistent formatting with Black
max-complexity = 10
