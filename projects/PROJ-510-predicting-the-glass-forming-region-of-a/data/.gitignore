# Ignore large data files in raw and processed directories
# These files are generated by the ingestion and feature engineering pipelines
# and should not be committed to version control.

# Raw data (usually large, binary or CSV)
data/raw/*
!data/raw/.gitkeep

# Processed data (derived from raw data)
data/processed/*
!data/processed/.gitkeep

# Model artifacts (large binary pickle files)
data/models/*
!data/models/.gitkeep

# Figures and plots (optional, can be large)
figures/*
!figures/.gitkeep
