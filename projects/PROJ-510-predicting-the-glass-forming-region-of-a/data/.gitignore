# Ignore large data files in raw and processed directories
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/models/*
!data/models/.gitkeep
data/figures/*
!data/figures/.gitkeep

# Explicitly ignore large file types
*.csv
*.pkl
*.parquet
*.h5
*.hdf5
*.json
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/models/.gitkeep
!data/figures/.gitkeep

# Ignore temporary files
*.tmp
*.temp
*.bak
*~
