[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    build,
    dist,
    .eggs,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py
    */__init__.py: F401
    # Allow imports in test files for clarity
    tests/*: E501
inline-quotes = double
multiline-quotes = double
docstring-quotes = double
count = True
statistics = True
