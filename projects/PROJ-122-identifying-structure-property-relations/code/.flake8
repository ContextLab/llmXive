[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist
per-file-ignores =
    # Allow unused imports in __init__.py for exports
    */__init__.py: F401
    # Allow docstrings without full sentences in tests
    tests/*: D100,D101,D102,D103
