{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IonSolventPair",
  "description": "Schema for experimental ion-solvent pair data with uncertainty and metadata.",
  "type": "object",
  "properties": {
    "ion_identifier": {
      "type": "string",
      "description": "Unique identifier for the ion (e.g., 'Na+', 'Cl-')."
    },
    "solvent_identifier": {
      "type": "string",
      "description": "Unique identifier for the solvent (e.g., 'water', 'methanol')."
    },
    "experimental_deltaG": {
      "type": "number",
      "description": "Experimental solvation free energy in kcal/mol."
    },
    "uncertainty": {
      "type": "number",
      "description": "Uncertainty associated with the experimental value."
    },
    "temperature": {
      "type": "number",
      "description": "Measurement temperature in Kelvin."
    },
    "charge": {
      "type": "number",
      "description": "Integer charge of the ion."
    },
    "radius": {
      "type": "number",
      "description": "Ionic radius in Angstroms."
    },
    "radius_type": {
      "type": "string",
      "enum": ["crystal", "hydrated"],
      "description": "Type of radius used (crystal or hydrated)."
    },
    "instrument_metadata": {
      "type": "object",
      "description": "Metadata regarding the instrument or source used for measurement.",
      "properties": {
        "source": { "type": "string" },
        "instrument": { "type": "string" },
        "precision": { "type": "string" }
      },
      "required": ["source"]
    }
  },
  "required": [
    "ion_identifier",
    "solvent_identifier",
    "experimental_deltaG",
    "uncertainty",
    "temperature",
    "charge",
    "radius",
    "radius_type",
    "instrument_metadata"
  ],
  "additionalProperties": false
}
