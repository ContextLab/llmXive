[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    build,
    dist,
    .eggs,
    *.egg-info,
    .idea,
    .vscode,
    data/,
    state/,
    figures/
per-file-ignores =
    # Allow unused imports in __init__.py
    */__init__.py: F401
    # Allow long lines in data files if any
    data/*.py: E501
