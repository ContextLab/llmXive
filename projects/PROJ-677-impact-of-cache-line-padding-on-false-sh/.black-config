# Configuration for black
line-length = 88
target-version = ['py311']
include = '\.pyi?$'
exclude = '''
(
    /(
        \.git
      | \.hg
      | \.mypy_cache
      | \.tox
      | \.venv
      | _build
      | buck-build
      | build
      | dist
      | venv
      | env
      | __pycache__
    )/
)
'''
