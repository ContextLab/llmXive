[MAIN]
init-hook='import sys; sys.path.append("code")'
ignore-patterns=^\.#

[MESSAGES CONTROL]
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    R0903,  # too-few-public-methods
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    W0511,  # fixme
    W1203,  # lazy-formatting
    E1101,  # instance-has-no-member (often false positives with dynamic attrs)
    R0801,  # duplicate-code (handled by isort/black usually)
good-names=
    i, j, k,
    df,
    ex,
    id,
    pk,
    fk,
    ts,
    fn,
    _

[FORMAT]
max-line-length=88

[DESIGN]
max-args=10
max-locals=20
max-returns=6
max-branches=15
max-statements=60
max-attributes=15
max-public-methods=25

[SIMILARITIES]
min-similarity-lines=6
ignore-comments=yes
ignore-docstrings=yes
