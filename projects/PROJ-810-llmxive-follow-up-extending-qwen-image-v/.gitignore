# Data artifacts (Generated by pipeline)
# Raw data - never commit
data/raw/
data/raw/*
!data/raw/.gitkeep

# Interim data (processed but not final)
data/interim/
data/interim/*
!data/interim/.gitkeep

# Processed data (optional, usually large)
data/processed/
data/processed/*
!data/processed/.gitkeep

# Results and logs
data/results/*.json
data/results/*.csv
data/results/*.parquet
data/results/*.log

# Manual audit files (may contain sensitive info or large text)
data/manual/
data/manual/*
!data/manual/.gitkeep

# Figures and plots
figures/
figures/*

# Model weights and large binaries
models/
models/*
!models/.gitkeep

# Cache directories
.cache/
cache/

