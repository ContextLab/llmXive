{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:llmxive:contract:importance_profile:v1",
  "title": "Importance Profile Schema",
  "description": "Schema for a single window's feature importance profile generated by the model.",
  "type": "object",
  "properties": {
    "window_id": { "type": "integer", "description": "Identifier for the time window" },
    "model_type": { "type": "string", "const": "RandomForestRegressor" },
    "model_params": {
      "type": "object",
      "properties": {
        "n_estimators": { "type": "integer", "const": 100 },
        "max_depth": { "type": "integer", "const": 10 },
        "random_state": { "type": "integer", "const": 42 }
      },
      "required": ["n_estimators", "max_depth", "random_state"]
    },
    "performance": {
      "type": "object",
      "properties": {
        "r2_score": { "type": "number", "minimum": -1, "maximum": 1 },
        "is_valid": { "type": "boolean" }
      },
      "required": ["r2_score", "is_valid"]
    },
    "importance_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_name": { "type": "string" },
          "importance_mean": { "type": "number" },
          "importance_std": { "type": "number" }
        },
        "required": ["feature_name", "importance_mean", "importance_std"]
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["window_id", "model_type", "model_params", "performance", "importance_scores", "generated_at"]
}
