# flake8 configuration for the Feature Importance Drift Analysis project.
# Run from the code/ directory: flake8 .
[flake8]
max-line-length = 100
extend-ignore =
    E203,
    W503
exclude =
    .venv,
    venv,
    __pycache__,
    .git,
    data,
    outputs,
    figures
max-complexity = 15
per-file-ignores =
    tests/*: S101
