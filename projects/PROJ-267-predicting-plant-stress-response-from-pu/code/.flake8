[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    venv,
    .venv
per-file-ignores =
    # Allow unused imports in __init__.py for re-exports
    code/__init__.py:F401
    # Allow unused arguments in test functions and callbacks
    tests/*:ARG
    code/modeling/train.py:ARG
    code/modeling/hyperparameter_config.py:ARG
