[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg-info,
    build,
    dist,
    data,
    results,
    docs
per-file-ignores =
    # Allow unused imports in __init__.py
    */__init__.py: F401
    # Allow high line length in tests for readability
    tests/*: E501
