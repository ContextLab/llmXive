[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist,
    .venv,
    venv
per-file-ignores =
    # Allow unused imports in __init__.py for exports
    */__init__.py: F401
    # Allow unused arguments in tests
    tests/*: ARG001, ARG002
