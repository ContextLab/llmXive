[flake8]
max-line-length = 88
extend-ignore = E203, E266, W503
exclude = .git,__pycache__,build,dist,venv,env,.venv
per-file-ignores =
    # Allow unused imports in __init__.py
    */__init__.py:F401
    # Allow unused arguments in test files
    tests/*:ARG001,ARG002,ARG003
inline-quotes = double
extend-exclude = .venv,venv,env
