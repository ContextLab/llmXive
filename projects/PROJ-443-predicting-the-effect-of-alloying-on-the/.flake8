[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude = .git,__pycache__,build,dist,.eggs,*.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py for public API exposure
    */__init__.py:F401
    # Allow unused arguments in tests and some utility functions
    tests/*:ARG
    code/utils/seeds.py:ARG
max-complexity = 15
inline-quotes = double
multiline-quotes = double
docstring-quotes = double
count = True
show-source = True
statistics = True
