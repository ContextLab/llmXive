# Ignore all data files by default
# Specific files must be explicitly kept via .gitkeep in subdirectories

# Raw data: Ignore all generated raw data
raw/*
!raw/.gitkeep

# Derived data: Ignore all processed data
derived/*
!derived/.gitkeep

# Validation data: Ignore all validation files
validation/*
!validation/.gitkeep

# Logs: Ignore all log files
logs/*
!logs/.gitkeep

# Explicitly keep placeholder files
**/.gitkeep
