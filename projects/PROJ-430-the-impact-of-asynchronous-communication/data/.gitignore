# Data Directory Structure
# This file ensures that data files are not tracked by Git,
# while preserving the directory structure.

# Raw data: Downloaded from external sources (GitHub API, etc.)
raw/*
!raw/.gitkeep

# Derived data: Processed and transformed data
derived/*
!derived/.gitkeep

# Validation data: Ground truth, manual annotations, test datasets
validation/*
!validation/.gitkeep

# Temporary processing files
*.tmp
*.temp
*.part

# Cache files
.cache/

# Large binary files (parquet, pickle, etc.)
*.parquet
*.pkl
*.pickle
*.feather
*.h5
*.hdf5

# Log files generated during data processing
*.log

# IDE and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python cache in data directories
__pycache__/
*.py[cod]
$py.class

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Environment-specific files
.env
*.env

# Exclude all files except .gitkeep in subdirectories
!**/.gitkeep
