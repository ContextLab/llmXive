# Data directory: Track structure, exclude raw/ and derived/ content
# Raw data files (large, often proprietary or API-rate-limited)
raw/*
!raw/.gitkeep

# Derived data (intermediate processing results, can be regenerated)
derived/*
!derived/.gitkeep

# Validation data (manual annotations, ground truth)
validation/*
!validation/.gitkeep

# Logs and temporary files generated during data processing
*.log
*.tmp
*.cache
__pycache__/

# IDE and OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo

# Ensure directory structure is preserved but content is ignored
**/.gitkeep
