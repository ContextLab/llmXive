[flake8]
# Maximum allowed line length for code lines
max-line-length = 88

# Exclude common directories and files from linting
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    *.egg-info

# Extend the default ignore list
# E203: whitespace before ':' (conflicts with black)
# W503: line break before binary operator (handled by black)
extend-ignore = E203, W503

# Enable more thorough checks
select = C,E,F,W,B,B950

# Per-file-ignores can be added here if needed
# per-file-ignores =
#     tests/*: D101 D102 D103

# Enable flake8-bugbear and other plugins if installed
enable-extensions = B

# Report style
format = %(path)s:%(row)d:%(col)d: %(code)s %(text)s