[run]
source = code
omit =
    */tests/*
    */venv/*
    */__pycache__/*
    code/setup_data_dirs.py
    code/format_lint_check.py
    code/cleanup_refactor.py
    code/main.py
    
[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    
[html]
directory = docs/coverage_html
