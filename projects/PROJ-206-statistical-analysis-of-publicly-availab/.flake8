[flake8]
# Max line length matches Black's default
max-line-length = 88
# Exclude common directories
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    env,
    .eggs,
    *.egg-info,
    data,
    state,
    .github
# Ignore specific warnings that conflict with Black formatting
ignore = E203, W503
