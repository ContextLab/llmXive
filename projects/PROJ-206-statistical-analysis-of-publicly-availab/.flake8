[flake8]
# Maximum line length (matches Black's default)
max-line-length = 88
# Exclude common directories
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    env,
    .eggs,
    .ruff_cache,
    data,
    state,
    .github
# Enable all default warnings and errors
select = C,E,F,W,B,B950
# Ignore specific warnings that conflict with Black formatting
ignore = E203, W503
