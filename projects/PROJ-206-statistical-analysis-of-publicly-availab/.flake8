[flake8]
# Match Black's line length
max-line-length = 88
# E203: whitespace before ':' (not PEP 8 compliant, but used by Black)
# W503: line break before binary operator (not PEP 8 compliant, but used by Black)
extend-ignore = E203, W503
# Exclude standard non-source directories
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    venv,
    .venv,
    data,
    state,
    .mypy_cache
