[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .tox,
    .venv
per-file-ignores =
    # Allow unused imports in __init__.py files for API exposure
    */__init__.py: F401
import-order-style = black
application-import-names = analysis,data,experiments,models,utils
