[flake8]
# Maximum line length (handled by Black)
max-line-length = 88
# Exclude common directories
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    .mypy_cache,
    .ruff_cache
# Ignore specific warnings
ignore =
    E203,  # whitespace before ':', handled by Black
    W503   # line break before binary operator, handled by Black
