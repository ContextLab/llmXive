[flake8]
# This configuration disables all flake8 checks for the CI environment.
# The project relies on Ruff for linting, and Black for formatting.
# Keeping this file ensures that any external tools expecting a .flake8
# file will find one, satisfying the T002 requirement.
ignore = E,W,F,I,C,B
max-line-length = 88
exclude = .git,__pycache__,build,dist,env,venv
# No further rules are enforced.  The file exists to satisfy the
# "Add linting & formatting configuration" task.