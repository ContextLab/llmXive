# Flake8 configuration
#
# This file configures flake8 to enforce PEP8 style and other quality checks.
# The settings are aligned with the project's black formatting preferences.
#
# For more details, see https://flake8.pycqa.org/en/latest/user/configuration.html
[flake8]
# Maximum allowed line length; must match Black's configuration.
max-line-length = 88
# Exclude common directories that do not contain source code.
exclude =
    __pycache__,
    data,
    results,
    state,
    docs,
    .git,
    venv,
    env
# Ignore specific style warnings that conflict with Black's formatting.
ignore = E203, W503
# Enable the built‑in pycodestyle and pyflakes checks.
select = C,E,F,W,B,B950
