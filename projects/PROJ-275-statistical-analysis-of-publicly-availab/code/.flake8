[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist
per-file-ignores =
    # Allow unused imports in __init__.py if any
    */__init__.py: F401
    # Allow too many imports in test files for setup convenience
    tests/*.py: E501, F401
