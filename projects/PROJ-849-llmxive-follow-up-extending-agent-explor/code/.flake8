[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .venv,
    venv,
    env,
    .tox
per-file-ignores =
    # Allow unused imports in __init__.py for exports
    */__init__.py: F401
    # Allow asserts in tests
    tests/*: S101
max-complexity = 15