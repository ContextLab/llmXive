# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.eggs/
*.egg-info/
dist/
build/
bdist/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Project specific data and logs
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/logs/*
!data/logs/.gitkeep
reports/*
!reports/.gitkeep
state/*
!state/.gitkeep

# OS
.DS_Store
Thumbs.db

# Linting/Formatting cache
.mypy_cache/
.pytest_cache/
.ruff_cache/
