[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py for public API exposure
    */__init__.py: F401
    # Allow unused arguments in model validators and test fixtures
    code/data/models.py: ARG001
    tests/unit/*.py: ARG001, F811
    tests/integration/*.py: ARG001
max-complexity = 12
