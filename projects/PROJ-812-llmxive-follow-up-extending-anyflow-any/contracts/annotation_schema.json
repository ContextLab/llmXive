{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Annotation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["clip_id", "annotator_id", "score", "timestamp"],
  "properties": {
    "clip_id": {
      "type": "string",
      "description": "Unique identifier of the video clip."
    },
    "annotator_id": {
      "type": "string",
      "description": "Identifier of the human annotator."
    },
    "score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Continuity score in the inclusive range [0.0, 1.0]."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO‑8601 timestamp when the annotation was recorded."
    }
  }
}
