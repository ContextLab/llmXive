[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py for API surface exposure
    code/__init__.py: F401
    # Allow unused arguments in test stubs if any
    tests/*: F841
count = True
show-source = True
statistics = True
