[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py for re-exports
    */__init__.py: F401
    # Allow unused variables in tests
    tests/*: F841