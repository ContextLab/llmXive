[flake8]
max-line-length = 88
extend-ignore = E203, E266, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    build,
    dist,
    *.egg-info,
    .venv,
    venv,
    env
per-file-ignores =
    # Allow unused imports in __init__.py for public API exposure
    */__init__.py: F401
    # Allow high complexity in main orchestration files if needed
    code/main.py: C901
    code/bes/loop_runner.py: C901
import-order-style = google
application-import-names = code, bes, dataset, analysis, symbolic, utils