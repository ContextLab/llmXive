# Data Artifacts (Explicitly handled per T005)
# Ignore all content in data directories except .gitkeep files to track structure
data/raw/*
!data/raw/.gitkeep
data/derived/*
!data/derived/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep

