[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist
per-file-ignores =
    # Allow unused imports in __init__.py if present (not currently used but good practice)
    __init__.py: F401
max-complexity = 15
