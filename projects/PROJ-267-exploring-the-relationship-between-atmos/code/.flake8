[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist,
    .venv,
    venv
per-file-ignores =
    # Allow wildcard imports in __init__ files if they exist
    __init__.py: F403, F405
    # Allow unused variables in test files for setup purposes
    tests/*.py: F841
