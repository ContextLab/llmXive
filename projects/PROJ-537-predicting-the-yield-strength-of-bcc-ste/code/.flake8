[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py for API surface exposure
    */__init__.py: F401
    # Allow imports in test files that might only be used in fixtures
    tests/*: F401
