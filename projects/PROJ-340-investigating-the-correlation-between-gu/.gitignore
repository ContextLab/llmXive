# Data directories - exclude all raw, processed, and results data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/results/*
!data/results/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
data/config/*
!data/config/.gitkeep
data/citations/*
!data/citations/.gitkeep

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Environment and secrets
.env
.env.local
.env.*.local

# Testing and IDE
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Project specific logs and temporary files
*.log
*.tmp
*.temp