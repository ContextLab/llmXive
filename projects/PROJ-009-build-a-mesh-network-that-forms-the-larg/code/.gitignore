.idea/
.vscode/
*.swp
*.swo
*~

# Virtual environments
venv/
env/
.venv/

# OS files
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Coverage and testing
.coverage
htmlcov/
.tox/

# Configuration overrides (optional)
config.local.yaml
secrets.yaml
