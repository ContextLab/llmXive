rule all:
    input:
        # Final artefacts (placeholder – adjust as pipeline grows)
        expand("results/validation_report.txt",),
        expand("data/results/statistical_result.yaml",)

rule verify_data_availability:
    """
    Abort if every entry in the manifest is marked Unavailable.
    """
    input:
        manifest = "data/manifest.json"
    run:
        with open(input.manifest) as f:
            manifest = json.load(f)
        if all(entry.get("status") == "Unavailable" for entry in manifest):
            sys.exit("All datasets unavailable – aborting.")
        else:
            # Create a dummy file to satisfy Snakemake's need for an output
            Path("results/data_gap_verified.txt").touch()

