import os
from pathlib import Path
from config import Config

# Load configuration
config = Config()

# Define paths
RAW_DIR = Path(config.DATA_RAW)
PROCESSED_DIR = Path(config.DATA_PROCESSED)
RESULTS_DIR = Path(config.RESULTS)
CODE_DIR = Path("code")

# Ensure directories exist
for d in [RAW_DIR, PROCESSED_DIR, RESULTS_DIR]:
    d.mkdir(parents=True, exist_ok=True)

# Global rules
rule all:
    input:
        expand(
            RESULTS_DIR / "fidelity" / "{accession}_fidelity.json",
            accession=config.DATASET_ACCESSIONS
        )

rule download:
    output:
        count_matrix=RAW_DIR / "{accession}_counts.h5ad",
        labels=RAW_DIR / "{accession}_labels.csv"
    script:
        CODE_DIR / "download.py"

rule preprocess:
    input:
        count_matrix=RAW_DIR / "{accession}_counts.h5ad",
        labels=RAW_DIR / "{accession}_labels.csv"
    output:
        processed=PROCESSED_DIR / "{accession}_processed.h5ad"
    script:
        CODE_DIR / "preprocess.py"

rule embeddings:
    input:
        processed=PROCESSED_DIR / "{accession}_processed.h5ad"
    output:
        pca=PROCESSED_DIR / "{accession}_pca.h5ad",
        tsne=PROCESSED_DIR / "{accession}_tsne.h5ad",
        umap=PROCESSED_DIR / "{accession}_umap.h5ad"
    script:
        CODE_DIR / "embeddings.py"

rule geometry:
    input:
        processed=PROCESSED_DIR / "{accession}_processed.h5ad"
    output:
        geometry=RESULTS_DIR / "geometry" / "{accession}_geometry.json"
    script:
        CODE_DIR / "geometry.py"

rule cluster:
    input:
        processed=PROCESSED_DIR / "{accession}_processed.h5ad"
    output:
        clustered=PROCESSED_DIR / "{accession}_clustered.h5ad",
        resolution=RESULTS_DIR / "cluster" / "{accession}_resolution.json"
    script:
        CODE_DIR / "clustering.py"

rule fidelity:
    input:
        clustered=PROCESSED_DIR / "{accession}_clustered.h5ad",
        labels=RAW_DIR / "{accession}_labels.csv"
    output:
        fidelity=RESULTS_DIR / "fidelity" / "{accession}_fidelity.json"
    script:
        CODE_DIR / "clustering.py"
