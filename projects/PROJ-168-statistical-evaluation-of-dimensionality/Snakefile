"""
Snakemake workflow for the statistical evaluation pipeline.

This workflow includes:
  - data_gap_resolver: runs the data gap resolver script and produces a manifest.
  - verify_data_availability: aborts if all datasets are marked "Unavailable".
  - download: a placeholder rule that depends on the verification step.
"""

import os
import sys
import json
import shutil
import pathlib
import subprocess

# Directories used throughout the workflow
CODE_DIR = "code"
RESULTS_DIR = "results"
DATA_DIR = "data"

# ----------------------------------------------------------------------
# Default target
# ----------------------------------------------------------------------
rule all:
    """
    The final target of the workflow. In a full pipeline this would
    depend on downstream analysis results; for the purpose of this
    task we only require the download step to succeed.
    """
    input:
        os.path.join(DATA_DIR, ".downloaded")

# ----------------------------------------------------------------------
# Resolve data gaps (calls the existing Python script)
# ----------------------------------------------------------------------
rule data_gap_resolver:
    """
    Executes the existing data_gap_resolver script which validates raw
    count files and writes a report.  The report is copied to
    `data/manifest.json` so that downstream rules can consume it.
    """
    output:
        report = os.path.join(RESULTS_DIR, "data_gap_report.json"),
        manifest = os.path.join(DATA_DIR, "manifest.json")
    run:
        # Run the resolver script
        ret = subprocess.run(
            [sys.executable, os.path.join(CODE_DIR, "data_gap_resolver.py")],
            check=False,
        )
        if ret.returncode != 0:
            sys.exit(ret.returncode)

        # The resolver writes its report to results/data_gap_report.json.
        # Copy that file to data/manifest.json so that the next rule can
        # read a manifest in the expected location.
        shutil.copy(output.report, output.manifest)

# ----------------------------------------------------------------------
# Verify that at least one dataset is available
# ----------------------------------------------------------------------
rule verify_data_availability:
    """
    Reads `data/manifest.json` and aborts the workflow with a clear
    error message if every dataset has `"status": "Unavailable"`.
    """
    input:
        manifest = os.path.join(DATA_DIR, "manifest.json")
    output:
        touch(os.path.join(DATA_DIR, ".verified"))
    run:
        with open(input.manifest, "r") as f:
            manifest = json.load(f)

        # The manifest may contain a top‑level list or a dict with a
        # "datasets" key.  Normalise to a list of dataset records.
        if isinstance(manifest, dict) and "datasets" in manifest:
            datasets = manifest["datasets"]
        elif isinstance(manifest, list):
            datasets = manifest
        else:
            datasets = []

        # Determine whether all entries are marked as Unavailable.
        all_unavailable = all(
            d.get("status", "").lower() == "unavailable" for d in datasets
        )

        if all_unavailable:
            sys.exit("All datasets unavailable – aborting.")

        # If we get here the check passed – create the sentinel file.
        pathlib.Path(output[0]).touch()

# ----------------------------------------------------------------------
# Placeholder download rule (depends on verification)
# ----------------------------------------------------------------------
rule download:
    """
    In the full pipeline this rule would download raw count matrices.
    For this task it simply demonstrates the dependency on the
    verification step.
    """
    input:
        verified = os.path.join(DATA_DIR, ".verified")
    output:
        touch(os.path.join(DATA_DIR, ".downloaded"))
    shell:
        """
        # No real download is performed in this minimal example.
        # The presence of the sentinel file indicates the step succeeded.
        touch {output}
        """