# Snakemake workflow for Statistical Evaluation of Dimensionality Reduction
# PROJ-168-statistical-evaluation-of-dimensionality

import os
import sys
import logging
from pathlib import Path
import json

# Add code directory to path for imports
sys.path.insert(0, str(Path(__file__).parent / "code"))

from config import Config
from data_gap_resolver import DataGapResolver, DatasetStatus

# Initialize logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("Snakemake")

# Configuration
config = Config()
RAW_DATA_DIR = config.RAW_DATA_DIR
PROCESSED_DATA_DIR = config.PROCESSED_DATA_DIR
RESULTS_DIR = config.RESULTS_DIR
DATASET_ACCESSIONS = config.DATASET_ACCESSIONS

# Ensure output directories exist
for d in [RAW_DATA_DIR, PROCESSED_DATA_DIR, RESULTS_DIR]:
    Path(d).mkdir(parents=True, exist_ok=True)

# Global variables for workflow
CASE_STUDY_MODE = False
AVAILABLE_DATASETS = []

def verify_data_availability():
    """
    Check if raw count matrices are available for the required accessions.
    Returns a tuple (is_available, available_datasets, missing_datasets).
    """
    resolver = DataGapResolver(
        accessions=DATASET_ACCESSIONS,
        raw_data_dir=str(RAW_DATA_DIR)
    )
    
    # Check availability
    available = []
    missing = []
    
    for accession in DATASET_ACCESSIONS:
        status = resolver.check_availability(accession)
        if status == DatasetStatus.AVAILABLE:
            available.append(accession)
        else:
            missing.append(accession)
    
    is_available = len(available) > 0
    return is_available, available, missing

# Rule: verify_data_availability
rule verify_data_availability:
    output:
        "results/data_gap_report.json"
    run:
        logger.info("Starting data availability verification...")
        
        is_available, available_datasets, missing_datasets = verify_data_availability()
        
        # Update global state
        global CASE_STUDY_MODE, AVAILABLE_DATASETS
        AVAILABLE_DATASETS = available_datasets
        CASE_STUDY_MODE = len(available_datasets) == 1
        
        # Create report
        report = {
            "status": "Full" if len(available_datasets) > 1 else ("Case-Study" if len(available_datasets) == 1 else "Aborted"),
            "available_datasets": available_datasets,
            "missing_datasets": missing_datasets,
            "total_required": len(DATASET_ACCESSIONS),
            "total_found": len(available_datasets),
            "case_study_mode": CASE_STUDY_MODE
        }
        
        # Write report
        with open(output[0], 'w') as f:
            json.dump(report, f, indent=2)
        
        if not is_available:
            logger.error("No valid raw count sources found for required accessions.")
            logger.error("Missing: " + ", ".join(missing_datasets))
            sys.exit(1)
        
        logger.info(f"Data verification complete. Found {len(available_datasets)} datasets.")
        if CASE_STUDY_MODE:
            logger.info("Switching to Case-Study mode (Single Dataset).")
        else:
            logger.info("Proceeding with multi-dataset analysis.")

# Rule: download
rule download:
    input:
        "results/data_gap_report.json"
    output:
        lambda wildcards: f"{RAW_DATA_DIR}/{wildcards.accession}_counts.h5ad"
    run:
        accession = wildcards.accession
        
        # Verify dataset is available before downloading
        if accession not in AVAILABLE_DATASETS:
            raise ValueError(f"Dataset {accession} is not available. Check data_gap_report.json.")
        
        from download import download_dataset
        logger.info(f"Downloading dataset: {accession}")
        download_dataset(accession, str(RAW_DATA_DIR))
        logger.info(f"Download complete for {accession}")

# Rule: preprocess
rule preprocess:
    input:
        lambda wildcards: f"{RAW_DATA_DIR}/{wildcards.accession}_counts.h5ad"
    output:
        f"{PROCESSED_DATA_DIR}/{{accession}}_processed.h5ad"
    run:
        accession = wildcards.accession
        from preprocess import run_preprocessing
        logger.info(f"Preprocessing dataset: {accession}")
        run_preprocessing(accession, str(RAW_DATA_DIR), str(PROCESSED_DATA_DIR))
        logger.info(f"Preprocessing complete for {accession}")

# Rule: embeddings
rule embeddings:
    input:
        lambda wildcards: f"{PROCESSED_DATA_DIR}/{wildcards.accession}_processed.h5ad"
    output:
        directory(f"{PROCESSED_DATA_DIR}/{{accession}}_embeddings")
    run:
        accession = wildcards.accession
        from embeddings import run_embeddings
        logger.info(f"Generating embeddings for: {accession}")
        output_dir = f"{PROCESSED_DATA_DIR}/{accession}_embeddings"
        Path(output_dir).mkdir(parents=True, exist_ok=True)
        run_embeddings(accession, str(PROCESSED_DATA_DIR), output_dir)
        logger.info(f"Embeddings complete for {accession}")

# Rule: geometry
rule geometry:
    input:
        lambda wildcards: f"{PROCESSED_DATA_DIR}/{wildcards.accession}_processed.h5ad"
    output:
        f"{RESULTS_DIR}/{{accession}}_geometry.json"
    run:
        accession = wildcards.accession
        from geometry import run_geometry_analysis
        logger.info(f"Computing geometry metrics for: {accession}")
        run_geometry_analysis(accession, str(PROCESSED_DATA_DIR), str(RESULTS_DIR))
        logger.info(f"Geometry analysis complete for {accession}")

# Rule: cluster
rule cluster:
    input:
        lambda wildcards: f"{PROCESSED_DATA_DIR}/{wildcards.accession}_processed.h5ad"
    output:
        f"{RESULTS_DIR}/{{accession}}_clustering.json"
    run:
        accession = wildcards.accession
        from clustering import process_accession
        logger.info(f"Running clustering for: {accession}")
        process_accession(accession, str(PROCESSED_DATA_DIR), str(RESULTS_DIR))
        logger.info(f"Clustering complete for {accession}")

# Rule: fidelity
rule fidelity:
    input:
        lambda wildcards: f"{RESULTS_DIR}/{wildcards.accession}_clustering.json"
    output:
        f"{RESULTS_DIR}/{{accession}}_fidelity.json"
    run:
        accession = wildcards.accession
        from clustering import calculate_fidelity_metrics
        logger.info(f"Calculating fidelity metrics for: {accession}")
        calculate_fidelity_metrics(accession, str(RESULTS_DIR))
        logger.info(f"Fidelity metrics complete for {accession}")

# Rule: stats
rule stats:
    input:
        expand(f"{RESULTS_DIR}/{{acc}}_fidelity.json", acc=AVAILABLE_DATASETS)
    output:
        f"{RESULTS_DIR}/statistical_analysis.json"
    run:
        from stats import run_analysis_with_error_handling
        logger.info("Running statistical analysis...")
        run_analysis_with_error_handling(AVAILABLE_DATASETS, str(RESULTS_DIR))
        logger.info("Statistical analysis complete")

# Default target
rule all:
    input:
        f"{RESULTS_DIR}/statistical_analysis.json"
    message:
        "Workflow complete. Check results/ for outputs."

# Resource monitoring
rule resource_monitor:
    input:
        "results/monitoring.csv"
    output:
        "results/resource_report.json"
    run:
        from utils import parse_time_logs
        logger.info("Aggregating resource monitoring logs...")
        parse_time_logs(str(RESULTS_DIR))
        logger.info("Resource monitoring complete")