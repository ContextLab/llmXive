import json
import os

# Default target for the pipeline
rule all:
    input:
        "data/manifest.json"

# T006: Minimal data_gap_resolver rule that calls the resolver script
rule data_gap_resolver:
    output:
        "data/manifest.json"
    shell:
        "python code/data_gap_resolver.py"

# T006: verify_data_availability rule
# Reads the manifest and aborts the workflow if all datasets are Unavailable.
rule verify_data_availability:
    input:
        "data/manifest.json"
    output:
        "data/.availability_verified"
    run:
        import json
        import os
        
        with open(input[0], 'r') as f:
            manifest = json.load(f)
        
        # Condition: Abort if ALL datasets are marked "Unavailable"
        # We check if the manifest is empty or if every entry has status == "Unavailable"
        if not manifest or all(d.get('status') == 'Unavailable' for d in manifest):
            # Raising an exception in a 'run' block aborts the Snakemake workflow
            raise Exception("All datasets unavailable – aborting.")
        
        # If at least one is available, create the sentinel file to allow downstream rules
        with open(output[0], 'w') as f:
            f.write("verified")

# T006: download rule
# The verify_data_availability rule is a prerequisite for this rule.
rule download:
    input:
        "data/.availability_verified"
    shell:
        "python code/download.py"