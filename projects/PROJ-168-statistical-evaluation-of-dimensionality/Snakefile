"""
Minimal Snakemake workflow for the dimensionality reduction pipeline.

This workflow defines:
  * verify_data_availability – aborts if all datasets in the manifest are marked "Unavailable".
  * download               – runs the data_gap_resolver script (which writes the manifest).
  * data_gap_resolver      – a thin wrapper around the existing Python script.

The verify_data_availability rule is a prerequisite of the download rule, as required.
"""

import json
import sys
from pathlib import Path

rule verify_data_availability:
    """
    Checks data/manifest.json. If every entry has "status": "Unavailable",
    the workflow aborts with a clear error message.
    """
    input:
        manifest="data/manifest.json"
    output:
        marker="data/.verify_data_availability.done"
    run:
        manifest_path = input.manifest
        with open(manifest_path, "r", encoding="utf-8") as f:
            manifest = json.load(f)

        all_unavailable = all(
            entry.get("status", "").lower() == "unavailable"
            for entry in manifest
        )
        if all_unavailable:
            print("All datasets unavailable – aborting.", file=sys.stderr)
            sys.exit(1)

        # Touch a marker file so downstream rules can depend on it.
        Path(output.marker).touch()

rule data_gap_resolver:
    """
    Executes the existing Python data_gap_resolver script.
    The script writes data/manifest.json (and related summary files).
    """
    output:
        manifest="data/manifest.json"
    shell:
        """
        python code/data_gap_resolver.py
        """

rule download:
    """
    Depends on successful verification and runs the resolver.
    """
    input:
        verified="data/.verify_data_availability.done"
    output:
        manifest="data/manifest.json"
    shell:
        """
        python code/data_gap_resolver.py
        """

# Default target – can be extended by later tasks.
rule all:
    input:
        "data/manifest.json"
