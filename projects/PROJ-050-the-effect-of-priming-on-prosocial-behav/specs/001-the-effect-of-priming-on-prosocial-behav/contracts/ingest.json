{
  "name": "ingest_contract",
  "description": "Contract for the data ingestion pipeline",
  "inputs": {
    "source": "jplu/tf-reddit-comments-2020",
    "subreddits": ["AskReddit", "science", "relationships"],
    "min_group_size": 4000
  },
  "outputs": {
    "file": "data/processed/anonymized.csv",
    "columns": ["comment_id", "thread_id", "user_id_hash", "body", "thread_type", "user_tenure"],
    "constraints": [
      "No plaintext usernames",
      "No raw timestamps (created_utc) in output",
      "At least 3 distinct subreddits",
      "raw_vs_fetched_count metric included in raw_counts.json"
    ]
  }
}