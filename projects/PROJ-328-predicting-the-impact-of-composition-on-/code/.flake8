[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    data,
    models,
    docs
per-file-ignores =
    # Allow unused imports in __init__.py
    */__init__.py:F401
    # Allow unused arguments in tests
    tests/*:ARG001
max-complexity = 15
