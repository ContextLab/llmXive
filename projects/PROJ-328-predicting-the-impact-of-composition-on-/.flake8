[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    data,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # Allow longer lines in test files for data fixtures
    tests/*: E501
    # Allow unused imports in __init__.py for API surface
    */__init__.py: F401
