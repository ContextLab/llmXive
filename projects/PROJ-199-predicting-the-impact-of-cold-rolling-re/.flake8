[flake8]
# Maximum line length
max-line-length = 88

# Extensions to ignore
extend-ignore = E203, E501, W503

# Exclude directories
exclude = 
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist,
    .venv,
    venv

# Per-file ignores
per-file-ignores =
    # Allow longer lines in test files for readability
    tests/*: E501

# Maximum complexity for cyclomatic complexity
max-complexity = 10