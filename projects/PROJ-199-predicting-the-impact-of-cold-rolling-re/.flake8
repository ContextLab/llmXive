[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    data,
    docs,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py for public API exposure
    */__init__.py: F401
    # Allow unused arguments in test files (pytest fixtures)
    tests/**/*.py: F811, W503
inline-quotes = double
multiline-quotes = double
docstring-quotes = double
count = True
statistics = True
show-source = True
