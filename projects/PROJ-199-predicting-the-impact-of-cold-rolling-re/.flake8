[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    data,
    build,
    dist
per-file-ignores =
    # Allow wildcard imports in __init__.py
    */__init__.py: F401
    # Allow unused variables in tests (placeholders)
    tests/*: F841
