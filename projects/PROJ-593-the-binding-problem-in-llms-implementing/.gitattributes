# Normalize line endings
*.sh text eol=crlf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.parquet binary
*.npy binary
*.pt binary
*.pth binary
*.h5 binary
