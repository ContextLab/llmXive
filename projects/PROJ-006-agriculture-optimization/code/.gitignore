# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Data (keep raw/processed in git if small, otherwise add to .gitignore)
# data/raw/*
# data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/logs/.gitkeep

# Reports and figures
reports/*.pdf
figures/*.png
figures/*.jpg

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
