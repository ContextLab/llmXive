{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegressionResult",
  "type": "object",
  "required": [
    "metric_name",
    "coefficient",
    "std_error",
    "t_statistic",
    "p_value",
    "model_r_squared"
  ],
  "properties": {
    "metric_name": {
      "type": "string"
    },
    "coefficient": {
      "type": "number"
    },
    "std_error": {
      "type": "number"
    },
    "t_statistic": {
      "type": "number"
    },
    "p_value": {
      "type": "number"
    },
    "model_r_squared": {
      "type": "number"
    },
    "topology": {
      "type": "string",
      "enum": ["ER", "BA", "WS"]
    }
  },
  "additionalProperties": false
}