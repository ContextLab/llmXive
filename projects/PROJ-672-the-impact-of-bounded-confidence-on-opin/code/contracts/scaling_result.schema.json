{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScalingResult",
  "type": "object",
  "required": ["topology", "network_id", "epsilon_c", "gamma", "r_squared", "standard_error"],
  "properties": {
    "topology": {
      "type": "string",
      "enum": ["ER", "BA", "WS"]
    },
    "network_id": {
      "type": "string",
      "description": "Identifier of the network instance."
    },
    "epsilon_c": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Estimated critical confidence threshold."
    },
    "gamma": {
      "type": "number",
      "description": "Scaling exponent."
    },
    "r_squared": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Coefficient of determination for the power‑law fit."
    },
    "standard_error": {
      "type": "number",
      "minimum": 0,
      "description": "Standard error of the gamma estimate."
    }
  },
  "additionalProperties": false
}
