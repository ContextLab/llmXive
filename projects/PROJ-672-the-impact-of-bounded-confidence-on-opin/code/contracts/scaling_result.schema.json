    "gamma",
    "epsilon_c",
    "r_squared",
    "standard_error"
  ],
  "properties": {
    "topology_type": {
      "type": "string",
      "enum": ["ER", "BA", "WS"]
    },
    "gamma": {
      "type": "number"
    },
    "epsilon_c": {
      "type": "number"
    },
    "r_squared": {
      "type": "number"
    },
    "standard_error": {
      "type": "number"
    }
  },
  "additionalProperties": false
}
