{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetworkInstance",
  "type": "object",
  "required": ["topology", "seed", "node_count", "edge_count"],
  "properties": {
    "topology": {
      "type": "string",
      "enum": ["ER", "BA", "WS"]
    },
    "seed": {
      "type": "integer"
    },
    "node_count": {
      "type": "integer",
      "minimum": 0
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
