{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScalingResult",
  "description": "Schema for the result of a scaling law analysis (power-law fit).",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string",
      "description": "Unique identifier for this analysis."
    },
    "topology": {
      "type": "string",
      "description": "Topology type this result applies to."
    },
    "epsilon_c": {
      "type": "number",
      "description": "Critical threshold detected."
    },
    "gamma": {
      "type": "number",
      "description": "Scaling exponent derived from power-law fit."
    },
    "r_squared": {
      "type": "number",
      "description": "R-squared value of the power-law fit."
    },
    "fit_parameters": {
      "type": "object",
      "properties": {
        "A": { "type": "number" },
        "c": { "type": "number" },
        "gamma": { "type": "number" }
      },
      "description": "Parameters of the fitted power-law model."
    },
    "critical_regime_range": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "Range [min_epsilon, max_epsilon] used for fitting."
    }
  },
  "required": ["analysis_id", "topology", "epsilon_c", "gamma", "r_squared"]
}
