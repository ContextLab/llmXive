[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    env,
    .eggs,
    *.egg-info,
per-file-ignores =
    # Allow unused imports in __init__.py
    */__init__.py: F401
    # Allow imported but unused in test files for type checking
    tests/*: F401
