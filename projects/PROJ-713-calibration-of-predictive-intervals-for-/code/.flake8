[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist
per-file-ignores =
    # Allow unused imports in __init__.py for public API exposure
    */__init__.py: F401
    # Allow unused arguments in model interfaces
    */models/*.py: ARG001, ARG002
    # Allow unused arguments in metric interfaces
    */metrics/*.py: ARG001, ARG002
