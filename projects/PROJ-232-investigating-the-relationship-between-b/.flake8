[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .tox,
    .venv,
    venv,
    env,
    node_modules,
per-file-ignores =
    # Allow unused imports in __init__.py
    code/src/__init__.py: F401
    code/tests/__init__.py: F401
import-order-style = google
application-import-names = src, tests
