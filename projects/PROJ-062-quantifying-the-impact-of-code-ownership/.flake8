[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    data/raw/*,
    data/intermediate/*,
    data/ownership_metrics/*,
    .venv,
    venv,
    env
per-file-ignores =
    # Allow unused imports in __init__.py for package exports
    */__init__.py: F401
