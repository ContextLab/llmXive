[flake8]
max-line-length = 100
ignore = E203, W503, E731
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py files for public API exposure
    */__init__.py: F401
    # Allow long lines in data files if necessary (rare)
    data/*.csv: E501
# Import sorting (requires isort, but flake8 can check basic order if needed)
# We rely on isort for strict sorting, flake8 for general style
import-order-style = google
