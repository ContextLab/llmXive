[flake8]
max-line-length = 88
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    data/raw,
    data/processed,
    data/reports,
    .pytest_cache,
    .mypy_cache,
extend-ignore = E203, E501
max-complexity = 10
per-file-ignores =
    # Allow longer lines in test files for fixtures
    tests/*: E501
    # Allow imports in __init__ files
    */__init__.py: F401