[flake8]
max-line-length = 100
ignore = E203, W503, E731
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # Allow unused imports in __init__.py
    */__init__.py: F401
    # Allow magic numbers in tests
    */tests/*.py: E701, E702, W503
    # Allow assertions in tests
    */tests/*.py: S101
max-complexity = 15