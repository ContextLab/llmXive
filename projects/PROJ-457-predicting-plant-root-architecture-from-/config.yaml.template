# Template configuration for the plant root architecture pipeline.
# Copy to `config.yaml` at the project root and adjust as needed.
# Any key omitted here falls back to the defaults in code/config.py.

# --- Paths (relative to the project root) ---
DATA_PATH: "data"
RAW_DATA_PATH: "data/raw"
PROCESSED_PATH: "data/processed"
ARTIFACTS_PATH: "artifacts"
LOGS_PATH: "artifacts/logs"
LOG_PATH: "artifacts/logs/pipeline.log"
MODEL_PATH: "artifacts/models"
PLOTS_PATH: "artifacts/reports/plots"
REPORTS_PATH: "artifacts/reports"

# --- Logging ---
LOG_LEVEL: "INFO"   # DEBUG | INFO | WARNING | ERROR

# --- Reproducibility ---
SEED: 42

# --- Pipeline parameters ---
MIN_SAMPLES_PER_SPECIES: 20
KNN_K: 5
MAX_PLOT_SIZE_MB: 100
