# Git LFS configuration for raw data files
# Track large binary and text data files to prevent repository bloat

# Raw sequencing data (FASTQ)
data/raw/**/*.fastq.gz filter=lfs diff=lfs merge=lfs -text
data/raw/**/*.fq.gz filter=lfs diff=lfs merge=lfs -text

# Aligned data (BAM/CRAM)
data/processed/**/*.bam filter=lfs diff=lfs merge=lfs -text
data/processed/**/*.cram filter=lfs diff=lfs merge=lfs -text

# Peak files and intermediate genomic coordinates (BED/BigWig)
data/processed/**/*.bed filter=lfs diff=lfs merge=lfs -text
data/processed/**/*.bw filter=lfs diff=lfs merge=lfs -text
data/processed/**/*.bigwig filter=lfs diff=lfs merge=lfs -text

# Hi-C contact matrices (Cool/HDF5)
data/processed/**/*.cool filter=lfs diff=lfs merge=lfs -text
data/processed/**/*.h5 filter=lfs diff=lfs merge=lfs -text

# Large result files (PDFs, large CSVs)
results/**/*.pdf filter=lfs diff=lfs merge=lfs -text
results/**/*.csv filter=lfs diff=lfs merge=lfs -text
results/**/*.tsv filter=lfs diff=lfs merge=lfs -text

# Figures (PNG, SVG)
figures/**/*.png filter=lfs diff=lfs merge=lfs -text
figures/**/*.svg filter=lfs diff=lfs merge=lfs -text

# Exclude small config and text files from LFS
!*.yaml
!*.yml
!*.json
!*.md
!*.txt
!*.sh
!*.py
!*.R
