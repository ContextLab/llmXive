[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist,
    .mypy_cache,
    .pytest_cache,
    venv,
    .venv
per-file-ignores =
    # Allow unused imports in __init__.py if present
    */__init__.py: F401
