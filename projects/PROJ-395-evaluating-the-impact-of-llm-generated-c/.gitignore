# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
.env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Data and State (excluding raw/processed which are git-ignored by convention, but keeping structure)
data/raw/*
data/processed/*
state/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!state/.gitkeep

# Logs
*.log

# OS
.DS_Store
Thumbs.db
