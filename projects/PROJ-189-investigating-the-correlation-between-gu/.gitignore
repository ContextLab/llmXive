# Large data files - exclude raw data from version control
data/raw/*
!data/raw/.gitkeep

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
.env/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
.cache/
.temp/

# Build and distribution
dist/
build/
*.egg-info/

# Jupyter notebooks (optional, uncomment if desired)
# *.ipynb_checkpoints

# Coverage and test reports
.coverage
htmlcov/
pytest.xml
.pytest_cache/

# Model artifacts (large files)
data/models/*
!data/models/.gitkeep