{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://llmxive.org/contracts/error_metric.json",
  "title": "ErrorMetric",
  "description": "Schema for a single empirical Type I error rate calculation result.",
  "type": "object",
  "properties": {
    "condition_id": {
      "type": "string",
      "description": "Unique identifier for the experimental condition."
    },
    "dataset_id": {
      "type": "integer",
      "description": "OpenML dataset ID used."
    },
    "missing_mechanism": {
      "type": "string",
      "enum": ["MCAR", "MAR", "MNAR"],
      "description": "The missing data mechanism applied."
    },
    "missing_rate": {
      "type": "number",
      "description": "The missingness rate applied."
    },
    "imputation_method": {
      "type": "string",
      "enum": ["complete_case", "mice", "ipw"],
      "description": "The analysis method used."
    },
    "n_iterations": {
      "type": "integer",
      "description": "Total number of iterations run."
    },
    "n_rejections": {
      "type": "integer",
      "description": "Count of times p-value < 0.05."
    },
    "empirical_error_rate": {
      "type": "number",
      "description": "Calculated empirical Type I error rate (n_rejections / n_iterations)."
    },
    "nominal_alpha": {
      "type": "number",
      "description": "Nominal significance level (e.g., 0.05)."
    },
    "relative_deviation": {
      "type": "number",
      "description": "(empirical - nominal) / nominal."
    },
    "is_tipping_point": {
      "type": "boolean",
      "description": "True if relative deviation exceeds threshold (e.g., > 10%)."
    },
    "fdr_adjusted_p": {
      "type": "number",
      "description": "Benjamini-Hochberg adjusted p-value for this condition."
    }
  },
  "required": [
    "condition_id",
    "dataset_id",
    "missing_mechanism",
    "missing_rate",
    "imputation_method",
    "n_iterations",
    "n_rejections",
    "empirical_error_rate",
    "nominal_alpha"
  ]
}
