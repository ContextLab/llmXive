{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ground Truth Oracle Schema",
  "description": "Schema for the deterministic state-transition oracle derived from Qwen-AgentWorld source code.",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "description": "Schema version" },
        "source": { "type": "string", "description": "Source code repository or file path" },
        "generated_at": { "type": "string", "format": "date-time" },
        "checksum": { "type": "string", "description": "SHA-256 of the source code or parser output" }
      },
      "required": ["version", "source", "generated_at"]
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Unique state identifier" },
          "type": { "type": "string", "enum": ["spatial", "temporal", "causal", "object", "agent"] },
          "attributes": { "type": "object", "additionalProperties": true },
          "constraints": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Logical constraints (Prolog/First-Order Logic strings)"
          }
        },
        "required": ["id", "type"]
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "from_state": { "type": "string", "description": "Reference to source state ID" },
          "to_state": { "type": "string", "description": "Reference to target state ID" },
          "action": { "type": "string", "description": "The action triggering the transition" },
          "preconditions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Conditions required for the transition"
          },
          "effects": {
            "type": "array",
            "items": { "type": "string" },
            "description": "State changes resulting from the transition"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 1.0,
            "description": "Deterministic probability (1.0 for Oracle)"
          }
        },
        "required": ["id", "from_state", "to_state", "action"]
      }
    },
    "interaction_logic": {
      "type": "object",
      "properties": {
        "spatial_rules": { "type": "array", "items": { "type": "string" } },
        "temporal_rules": { "type": "array", "items": { "type": "string" } },
        "causal_rules": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["metadata", "states", "transitions"]
}
