{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Divergence Report Schema",
  "description": "Schema for the final divergence quantification report comparing LLM, Extracted Rules, and Oracle.",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "oracle_source": { "type": "string" },
        "rules_source": { "type": "string" },
        "llm_model": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "total_tasks_evaluated": { "type": "integer" }
      },
      "required": ["version", "generated_at", "total_tasks_evaluated"]
    },
    "counts": {
      "type": "object",
      "properties": {
        "match": { "type": "integer", "description": "LLM == Oracle" },
        "hallucination": { "type": "integer", "description": "LLM != Oracle AND Rule Inferable" },
        "rule_gap": { "type": "integer", "description": "LLM != Oracle AND Rule Inferable BUT LLM failed" },
        "extraction_uncertainty": { "type": "integer", "description": "Excluded due to ambiguous traces" },
        "coverage_gap": { "type": "integer", "description": "Excluded due to cold start (no rules)" }
      },
      "required": ["match", "hallucination", "rule_gap", "extraction_uncertainty", "coverage_gap"]
    },
    "excluded_metrics": {
      "type": "object",
      "properties": {
        "extraction_uncertainty_count": { "type": "integer" },
        "cold_start_count": { "type": "integer" }
      },
      "required": ["extraction_uncertainty_count", "cold_start_count"]
    },
    "statistics": {
      "type": "object",
      "properties": {
        "adherence_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "hallucination_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "rule_gap_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "p_value": { "type": "number", "description": "From permutation test" },
        "significance_threshold": { "type": "number", "default": 0.05 },
        "boundary_threshold": {
          "type": "object",
          "properties": {
            "step_count": { "type": "integer" },
            "complexity_score": { "type": "number" }
          },
          "description": "Point where adherence drops below 95%"
        },
        "correlation_metrics": {
          "type": "object",
          "properties": {
            "rule_precision_vs_cot_quality": {
              "type": "number",
              "description": "Pearson's r between rule precision and CoT quality"
            }
          }
        }
      },
      "required": ["adherence_rate", "p_value", "significance_threshold"]
    },
    "detailed_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "step_index": { "type": "integer" },
          "classification": {
            "type": "string",
            "enum": ["match", "hallucination", "rule_gap", "extraction_uncertainty", "coverage_gap"]
          },
          "expected_state": { "type": "string" },
          "actual_state": { "type": "string" },
          "reasoning": { "type": "string" }
        },
        "required": ["task_id", "step_index", "classification"]
      }
    }
  },
  "required": ["metadata", "counts", "statistics"]
}