{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Extracted Rules Schema",
  "description": "Schema for the hypothesized rule set extracted from LLM Chain-of-Thought traces via ILP.",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "extraction_method": { "type": "string", "enum": ["ILP", "DecisionTree", "FOL"] },
        "model_version": { "type": "string" },
        "trace_source": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["version", "extraction_method", "generated_at"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "head": { "type": "string", "description": "The conclusion predicate" },
          "body": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of premise predicates"
          },
          "logic_form": { "type": "string", "description": "Full First-Order Logic representation" },
          "support_count": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_trace_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "References to CoT traces that supported this rule"
          }
        },
        "required": ["id", "head", "body", "logic_form"]
      }
    },
    "uncertainty_flags": {
      "type": "object",
      "properties": {
        "extraction_uncertainty": {
          "type": "integer",
          "description": "Count of traces with ambiguous or contradictory rule extraction"
        },
        "cold_start": {
          "type": "integer",
          "description": "Count of states/actions with no supporting traces"
        }
      },
      "required": ["extraction_uncertainty", "cold_start"]
    }
  },
  "required": ["metadata", "rules", "uncertainty_flags"]
}
