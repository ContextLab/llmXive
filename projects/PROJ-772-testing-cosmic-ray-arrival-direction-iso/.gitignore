# Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Environment and secrets
.env
.env.local
.env.*.local

# Data artifacts (large files, not for version control)
data/

# State files (generated checksums and pipeline state)
state/projects/*.yaml
# Keep the directory structure but ignore generated state files
!state/projects/.gitkeep

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
.tmp/