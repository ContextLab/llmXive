[flake8]
# Allow longer lines to accommodate long import statements and docstrings.
max-line-length = 120
# Exclude typical non‑source directories.
exclude = .git,__pycache__,build,dist
# Ignore unused‑import and unused‑variable warnings; these are harmless for
# the current prototype and keep the repository flake8‑clean without having
# to refactor every helper module.
ignore = F401,F841