# ----------------------------------------------------------------------
# Project‑wide ignore rules
# ----------------------------------------------------------------------
# Python byte‑code caches
__pycache__/
*.py[cod]

# Virtual‑environment directories (if any)
env/
venv/
.venv/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Data artefacts generated by the pipeline (they are versioned elsewhere)
data/processed/
data/results/
output/figures/
results/

# Logs
logs/
*.log

# ----------------------------------------------------------------------
# Hygiene patterns added by task T001
# ----------------------------------------------------------------------
t*.py           # orphaned experiment scripts
*.scratch       # temporary scratch files generated during ad‑hoc analysis
*.tmp           # generic temporary files
