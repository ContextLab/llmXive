[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    venv,
    .venv,
    env,
    .tox,
    data,
    state,
    docs
per-file-ignores =
    # Ignore unused imports in __init__.py if they are used for API exposure
    */__init__.py: F401
