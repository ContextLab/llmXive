# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Data Artifacts (Raw and Processed)
# Raw data is large and should not be committed
data/raw/
# Processed data (Parquet/CSV) can be large
data/processed/*.parquet
data/processed/*.csv
data/processed/*.h5
# Keep the directory structure but ignore the heavy files
!data/raw/.gitkeep
!data/processed/.gitkeep

# State and Checksums
state/*.json
state/*.log
!state/.gitkeep
!state/amendments.md

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Project specific
projects/
state/checksums.json

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Secrets
.env
.env.local
*.pem
*.key