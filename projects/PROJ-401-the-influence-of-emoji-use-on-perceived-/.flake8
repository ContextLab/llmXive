[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    build,
    dist,
    data,
    .venv,
    venv
per-file-ignores =
    # Allow unused imports in __init__.py for public API exposure
    */__init__.py: F401
    # Allow assertions in tests
    tests/*: S101
max-complexity = 15
statistics = True
show-source = True
