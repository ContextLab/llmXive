{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plant Phenology Pipeline Configuration",
  "description": "JSON Schema for the project configuration adhering to T004 requirements.",
  "type": "object",
  "properties": {
    "paths": {
      "type": "object",
      "properties": {
        "data_raw": { "type": "string" },
        "data_processed": { "type": "string" },
        "artifacts": { "type": "string" },
        "artifacts_models": { "type": "string" },
        "logs": { "type": "string" },
        "contracts": { "type": "string" }
      },
      "required": ["data_raw", "data_processed", "artifacts", "artifacts_models"]
    },
    "seeds": {
      "type": "object",
      "properties": {
        "global": { "type": "integer" },
        "train_test_split": { "type": "integer" },
        "cross_validation": { "type": "integer" }
      },
      "required": ["global"]
    },
    "api_keys": {
      "type": "array",
      "description": "List of API key identifiers loaded from environment.",
      "items": { "type": "string" }
    },
    "debug": {
      "type": "boolean"
    }
  },
  "required": ["paths", "seeds"]
}
