[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    venv,
    .venv,
    .tox
per-file-ignores =
    # Allow unused imports in __init__.py for re-exports
    code/src/__init__.py: F401
    # Allow unused imports in tests for fixtures
    code/tests/*.py: F401
