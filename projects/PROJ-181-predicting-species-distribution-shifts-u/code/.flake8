[flake8]
max-line-length = 88
extend-ignore = E203, E266, W503
exclude = .git,__pycache__,venv,build,dist
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py:F401
    # Allow print statements in main scripts if necessary
    code/download.py:T201
    code/train.py:T201
# Import sorting handled by isort (optional, but good practice)
# inline-comparisons = False
# docstring-convention = numpy
