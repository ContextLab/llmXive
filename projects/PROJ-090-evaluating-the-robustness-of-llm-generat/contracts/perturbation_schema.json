{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perturbation Candidate Schema",
  "description": "Schema for perturbation candidate output (v1.0)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Unique identifier for the original task"
      },
      "perturbation_type": {
        "type": "string",
        "enum": ["synonym", "typo", "rephrase"],
        "description": "Type of perturbation applied"
      },
      "raw_score": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Raw semantic similarity score"
      },
      "is_valid": {
        "type": "boolean",
        "description": "Whether the candidate passed validation"
      },
      "candidate_text": {
        "type": "string",
        "description": "The perturbed text content"
      }
    },
    "required": ["task_id", "perturbation_type", "raw_score", "is_valid", "candidate_text"]
  }
}
