# Data directories - exclude all generated and raw data
data/raw/*
data/processed/*
data/artifacts/*

# Python cache files
*.pyc
__pycache__

# State files - exclude all EXCEPT project-specific state
state/*.yaml
!state/PROJ-485/*.yaml

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs (unless needed for debugging)
data/logs/

# Virtual environments
venv/
.venv/
env/

# Build artifacts
dist/
build/
*.egg-info/