# Data directories - exclude all raw, processed, and artifact data
data/raw/*
data/processed/*
data/artifacts/*

# Python cache files
*.pyc
__pycache__

# State files - exclude all except project-specific state
state/*.yaml

# Allow project-specific state (Constitution Principle V)
!state/PROJ-485/*.yaml

# Editor and IDE files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Virtual environments
venv/
.venv/
env/
.env/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp