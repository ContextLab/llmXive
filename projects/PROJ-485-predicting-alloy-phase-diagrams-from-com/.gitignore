# Data directories (Constitution Principle V - exclude raw/processed/artifacts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep

# Python bytecode and cache
*.pyc
__pycache__
*.pyo
*.pyd
.Python

# State files (except specific project state)
state/*.yaml
!state/PROJ-485/*.yaml

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
data/logs/
*.log

# Virtual environments
venv/
env/
.venv/

# Jupyter notebooks
.ipynb_checkpoints

# Coverage reports
htmlcov/
.coverage
coverage.xml

# Testing
.pytest_cache/
.mypy_cache/
.ruff_cache/
