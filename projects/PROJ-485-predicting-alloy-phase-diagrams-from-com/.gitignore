# Data directories - exclude all raw, processed, and artifact data
# Constitution Principle III: Data integrity requires version control of code only
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep

# Python bytecode and cache
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# State files - exclude all except project-specific state
# Constitution Principle V: Project state must be tracked
state/*.yaml
!state/PROJ-485/*.yaml

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
.env
.venv/
venv/
env/

# Test coverage and profiling
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Build artifacts
dist/
build/
*.egg-info/