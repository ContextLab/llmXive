# Configuration for the lintr package
# Enforces consistent R style and catches common errors
exclude:
  - "renv/"
  - "tests/testthat.R"
linters:
  - trailing_whitespace_linter()
  - line_length_linter(120)
  - object_name_linter()
  - assignment_linter()
  - paren_body_linter()
  - brace_linter()
  - comma_linter()
  - function_brace_linter()
  - pipe_continuation_linter()
  - single_quotes_linter()
  - spaces_inside_linter()
  - spaces_left_parentheses_linter()
  - TODO_comment_linter()
  - unnecessary_concatenation_linter()
  - unneeded_concatenation_linter()
  - whitespace_linter()
  - xml_nodes_to_sax_linter()
exclusions:
  tests/:
    - trailing_whitespace_linter
    - line_length_linter
  code/0*_data_prep.R:
    - line_length_linter
  code/0*_analysis.R:
    - line_length_linter
