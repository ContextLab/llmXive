# lintr configuration for PROJ-399 (R 4.3+ project)
# Applied via options(lintr.linter_file = "code/.lintr") in code/lint.R
linters: with_defaults(
  closed_curly_linter = NULL,
  open_curly_linter = NULL,
  line_length_linter(100),
  object_name_linter = NULL,
  object_usage_linter = NULL,
  cyclocomp_linter = NULL,
  object_length_linter = NULL
)
exclusions: list(
  "renv",
  "renv.lock",
  "NAMESPACE"
)
exclude: "# nolint start: object_name_linter."
