# Ignore all large data files
# These are generated/downloaded and should not be committed

# Raw data (downloaded from external sources)
data/raw/*
!data/raw/.gitkeep

# Processed data (generated by pipelines)
data/processed/*
!data/processed/.gitkeep

# Temporary files
data/tmp/
*.tmp
*.temp

# Large binary files
*.h5
*.hdf5
*.parquet
*.pkl
*.pickle

# Cache files
data/cache/
__pycache__/
*.pyc

# Logs and intermediate results
*.log
intermediate_*