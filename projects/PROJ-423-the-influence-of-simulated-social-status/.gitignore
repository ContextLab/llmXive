# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables and secrets
.env

# Processed data (intermediate artifacts)
# Raw data MUST be tracked for checksumming per Constitution Principle III
data/processed/*.csv
data/processed/*.json
data/processed/*.parquet
data/processed/*.pkl

# Logs and temporary files
*.log
tmp/
.cache/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db

# Report outputs (generated)
reports/*.pdf
reports/*.html
figures/*.png
figures/*.jpg
figures/*.svg

# Checksums (managed by pipeline, not git-tracked raw data)
data/checksums.json