# flake8 configuration for PROJ-431 (predicting molecular complexity)
# Discovered automatically by flake8 when run from the project root,
# or explicitly via: flake8 --config code/.flake8
[flake8]
max-line-length = 100
extend-ignore =
    # E203: whitespace before ':' (conflicts with black slicing style)
    E203,
    # W503: line break before binary operator (black-compatible)
    W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    data,
    results
per-file-ignores =
    # allow long lines in test files where assertions are verbose
    tests/*:E501
max-complexity = 15
