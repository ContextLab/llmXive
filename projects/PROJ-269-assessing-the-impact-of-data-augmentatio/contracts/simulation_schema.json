{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulation Output Schema",
  "description": "Schema for Monte Carlo simulation results including p-value distributions, error rates, and metadata.",
  "type": "object",
  "required": [
    "metadata",
    "type_i_results",
    "type_ii_results"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Run configuration and provenance information.",
      "required": [
        "dataset_name",
        "sample_size",
        "augmentation_method",
        "num_iterations",
        "random_seed",
        "timestamp",
        "disclaimer"
      ],
      "properties": {
        "dataset_name": {
          "type": "string",
          "description": "Name of the source dataset (e.g., 'breast_cancer')."
        },
        "sample_size": {
          "type": "integer",
          "description": "Number of samples per iteration (e.g., 15, 25, 40)."
        },
        "augmentation_method": {
          "type": "string",
          "description": "Method used for augmentation (e.g., 'baseline', 'gaussian_noise', 'smote', 'random_oversampling').",
          "enum": [
            "baseline",
            "gaussian_noise",
            "smote",
            "random_oversampling"
          ]
        },
        "num_iterations": {
          "type": "integer",
          "description": "Total number of Monte Carlo iterations run."
        },
        "random_seed": {
          "type": "integer",
          "description": "Seed used for reproducibility."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the run."
        },
        "disclaimer": {
          "type": "string",
          "description": "Mandatory disclaimer string regarding associational findings.",
          "const": "DISCLAIMER: Findings are associational and derived from simulation on specific datasets. They should not be generalized without further validation."
        }
      }
    },
    "type_i_results": {
      "type": "object",
      "description": "Results for the Null Hypothesis (Type I Error) condition.",
      "required": [
        "p_values",
        "error_rate",
        "confidence_interval"
      ],
      "properties": {
        "p_values": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "List of p-values obtained from hypothesis tests across iterations."
        },
        "error_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Empirical Type I error rate (proportion of p < 0.05)."
        },
        "confidence_interval": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "95% Bootstrap confidence interval [lower, upper] for the error rate."
        },
        "ks_test": {
          "type": "object",
          "description": "Kolmogorov-Smirnov test results comparing p-value distribution to Uniform(0,1).",
          "required": [
            "statistic",
            "p_value"
          ],
          "properties": {
            "statistic": {
              "type": "number",
              "description": "KS test statistic."
            },
            "p_value": {
              "type": "number",
              "description": "KS test p-value."
            }
          }
        }
      }
    },
    "type_ii_results": {
      "type": "object",
      "description": "Results for the Alternative Hypothesis (Type II Error) condition.",
      "required": [
        "p_values",
        "error_rate",
        "confidence_interval",
        "power"
      ],
      "properties": {
        "p_values": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "List of p-values obtained from hypothesis tests across iterations."
        },
        "error_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Empirical Type II error rate (proportion of p >= 0.05)."
        },
        "confidence_interval": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "95% Bootstrap confidence interval [lower, upper] for the error rate."
        },
        "power": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Statistical power (1 - Type II error rate)."
        },
        "ks_test": {
          "type": "object",
          "description": "Kolmogorov-Smirnov test results comparing p-value distribution to Uniform(0,1).",
          "required": [
            "statistic",
            "p_value"
          ],
          "properties": {
            "statistic": {
              "type": "number",
              "description": "KS test statistic."
            },
            "p_value": {
              "type": "number",
              "description": "KS test p-value."
            }
          }
        }
      }
    }
  }
}