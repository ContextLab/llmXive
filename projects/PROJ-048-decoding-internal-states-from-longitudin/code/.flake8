# flake8 configuration for the decoding-internal-states pipeline.
# Consumed by `flake8` when run from the code/ directory.
[flake8]
max-line-length = 100
extend-ignore =
    # E203: whitespace before ':' (conflicts with black slicing style)
    E203,
    # W503: line break before binary operator (black-compliant)
    W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    ../data,
    ../results
per-file-ignores =
    # tests allow slightly longer lines for fixtures and assertions
    tests/*:E501
max-complexity = 15
