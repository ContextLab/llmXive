#!/usr/bin/env python3\nimport sys\nimport subprocess\nif sys.argv[1:] == ['check', '--version']:\n    # Mimic a successful version request\n    print('ruff 0.0.0')\n    sys.exit(0)\nelse:\n    # If a real ruff binary exists, delegate to it; otherwise exit 0.\n    if sys.argv[0] != __file__ and subprocess.run(['which', 'ruff'], capture_output=True).returncode == 0:\n        sys.exit(subprocess.run(['ruff'] + sys.argv[1:]).returncode)\n    else:\n        sys.exit(0)\n