[flake8]
# Maximum line length
max-line-length = 88

# Ignore specific error codes
# E501: line too long (handled by max-line-length)
# W503: line break before binary operator (conflicts with Black)
# E203: whitespace before ':' (conflicts with Black)
ignore = E501, W503, E203

# Exclude directories
exclude =
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist,
    .venv,
    venv,
    data,
    models,
    figures,
    .mypy_cache,
    .pytest_cache
    
# Per-file ignores (optional, can be added as needed)
# per-file-ignores = 
#     __init__.py: F401
    
# Max complexity for cyclomatic complexity check
max-complexity = 10