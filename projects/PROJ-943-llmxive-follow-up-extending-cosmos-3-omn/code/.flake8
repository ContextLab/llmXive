[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .eggs,
    *.egg-info,
    build,
    dist,
    .venv,
    venv,
    data,
    models
per-file-ignores =
    # Allow unused imports in __init__.py and test files for setup
    */__init__.py: F401
    */tests/*: F401, E501