#!/bin/bash
# Pre-commit hook for PROJ-361
# Triggers state updates on artifact changes to ensure versioning and hash tracking
# per Constitution Principle V (T006 implementation)

set -e

# Determine project root (assuming this script is at git_hooks/pre-commit)
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
HOOK_SCRIPT="${PROJECT_ROOT}/code/utils/update_state.py"

# Verify the update_state script exists
if [ ! -f "$HOOK_SCRIPT" ]; then
    echo "ERROR: State update script not found at $HOOK_SCRIPT"
    echo "Please ensure T006 has been completed."
    exit 1
fi

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo "ERROR: python3 is required but not found in PATH"
    exit 1
fi

# Run the state update script
# This will:
# 1. Scan staged artifacts in code/, data/, tests/, specs/
# 2. Calculate hashes for changed files
# 3. Register/update artifacts in the SQLite metadata registry
# 4. Update pipeline state tracking
echo "Running artifact state update..."
python3 "$HOOK_SCRIPT" --mode pre-commit

# Capture exit status
STATUS=$?

if [ $STATUS -eq 0 ]; then
    echo "State update completed successfully."
else
    echo "ERROR: State update failed with exit code $STATUS"
    echo "Commit blocked. Please fix the state tracking issue."
fi

exit $STATUS
