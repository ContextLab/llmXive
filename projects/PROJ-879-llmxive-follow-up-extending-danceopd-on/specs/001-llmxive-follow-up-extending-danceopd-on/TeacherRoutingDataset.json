{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://llmxive.org/schemas/TeacherRoutingDataset.json",
  "title": "TeacherRoutingDataset",
  "description": "Schema for the dataset containing prompt embeddings, noise levels, routing labels, and velocity vectors generated by the DanceOPD teacher model.",
  "type": "object",
  "properties": {
    "prompt_embedding": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float32"
      },
      "description": "CLIP-encoded prompt embedding vector.",
      "minItems": 512,
      "maxItems": 512
    },
    "noise_level": {
      "type": "number",
      "format": "float32",
      "description": "The noise level parameter used during generation.",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "routing_label": {
      "type": "string",
      "description": "The expert identifier assigned by the teacher model.",
      "pattern": "^expert_[a-z_]+$",
      "examples": ["expert_text_to_image", "expert_editing", "expert_inpainting"]
    },
    "velocity_vector": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float32"
      },
      "description": "The velocity vector output from the teacher model for the specified expert.",
      "minItems": 1,
      "maxItems": 100000
    },
    "source_dataset": {
      "type": "string",
      "description": "Origin dataset of the sample.",
      "enum": ["imagenet-1k", "laion-400m"]
    },
    "sample_id": {
      "type": "string",
      "description": "Unique identifier for the sample."
    }
  },
  "required": ["prompt_embedding", "noise_level", "routing_label", "velocity_vector", "source_dataset", "sample_id"],
  "additionalProperties": false
}
