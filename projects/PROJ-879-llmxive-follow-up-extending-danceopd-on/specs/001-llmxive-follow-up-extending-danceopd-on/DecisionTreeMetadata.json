{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionTreeMetadata",
  "description": "Schema for metadata associated with trained decision tree models.",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "description": "Unique identifier for the model."
    },
    "max_depth": {
      "type": "integer",
      "description": "Maximum depth of the decision tree."
    },
    "training_accuracy": {
      "type": "number",
      "description": "Accuracy on the training set."
    },
    "validation_accuracy": {
      "type": "number",
      "description": "Accuracy on the validation/test set."
    },
    "feature_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of features used in training."
    },
    "num_samples": {
      "type": "integer",
      "description": "Number of samples used for training."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of model creation."
    },
    "sha256_hash": {
      "type": "string",
      "description": "SHA256 hash of the model file."
    }
  },
  "required": ["model_id", "max_depth", "training_accuracy", "validation_accuracy", "num_samples", "created_at", "sha256_hash"]
}