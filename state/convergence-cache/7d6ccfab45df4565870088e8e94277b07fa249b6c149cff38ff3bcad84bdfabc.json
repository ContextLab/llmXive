{"_ts": 1791804724.99735, "concerns": [{"id": "internal_consistency-66e2a4b4", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-004", "text": "FR-004 states the matching step must fail if the mean difference in any covariate exceeds 5% **(standardized mean difference < 0.1)**. The two thresholds are contradictory: >5% implies a standardized mean difference >0.05, while '< 0.1' implies the opposite direction. Clarify the intended bound (e.g., >0.1 or >5%).", "round": 1}, {"id": "internal_consistency-25a34d6d", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-006", "text": "FR-006 requires sensitivity analysis across *at least 5* subsets stratified by repository star\u2011count **quartiles**. Quartiles produce exactly 4 groups, so the count requirement cannot be satisfied. Adjust either the number of subsets or the stratification method.", "round": 1}, {"id": "internal_consistency-573e19c0", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-001", "text": "FR\u2011001 (and other FRs) reference \u201cUS\u20111\u201d, \u201cUS\u20112\u201d, etc., but the document only defines *User Story 1*, *User Story 2*, etc. The referenced US identifiers do not exist, breaking traceability.", "round": 1}, {"id": "internal_consistency-d14f2d04", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-002", "text": "Same cross\u2011reference issue as above: FR\u2011002 cites \u201cUS\u20111\u201d which is undefined.", "round": 1}, {"id": "internal_consistency-50c8bd80", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-003", "text": "Same cross\u2011reference issue as above: FR\u2011003 cites \u201cUS\u20111\u201d.", "round": 1}, {"id": "internal_consistency-229c10b9", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-004", "text": "Same cross\u2011reference issue as above: FR\u2011004 cites \u201cUS\u20112\u201d.", "round": 1}, {"id": "internal_consistency-d4a63938", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-005", "text": "Same cross\u2011reference issue as above: FR\u2011005 cites \u201cUS\u20112\u201d.", "round": 1}, {"id": "internal_consistency-1cea2d01", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-006", "text": "Same cross\u2011reference issue as above: FR\u2011006 cites \u201cUS\u20113\u201d.", "round": 1}, {"id": "internal_consistency-04a9a60e", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-007", "text": "Same cross\u2011reference issue as above: FR\u2011007 cites \u201cUS\u20113\u201d.", "round": 1}, {"id": "internal_consistency-3e5ab425", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:FR-008", "text": "Same cross\u2011reference issue as above: FR\u2011008 cites \u201cUS\u20114\u201d.", "round": 1}, {"id": "internal_consistency-cca2927e", "reviewer": "internal_consistency", "severity": "requirement", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:SC-007", "text": "SC\u2011007 defines a syntactic\u2011validity threshold (\u226595%) for the prompt\u2011based cohort, but no functional requirement (e.g., FR\u2011XXX) mandates this metric. Add a requirement that enforces the 95\u202f% threshold.", "round": 1}, {"id": "internal_consistency-cc087957", "reviewer": "internal_consistency", "severity": "writing", "artifact": "projects/PROJ-302-evaluating-the-impact-of-code-generation/specs/001-evaluating-the-impact-of-code-generation/spec.md", "location": "spec.md:User Stories", "text": "Inconsistent terminology: the narrative uses \u201cUser Story 1\u201d, \u201cUser Story 2\u201d, etc., while the functional requirements refer to \u201cUS\u20111\u201d, \u201cUS\u20112\u201d, etc. Align the naming convention to avoid confusion.", "round": 1}]}